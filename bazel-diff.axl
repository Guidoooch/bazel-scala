"""Calculate impacted targets from the BASE commit

Based on
https://github.com/Tinder/bazel-diff/blob/master/bazel-diff-example.sh
"""

def exec(command, ctx_std):
    ctx_std.io.stdout.write("  [exec] %s\n" % command)
    return command.stdout("piped").spawn().wait_with_output().stdout.strip()

# buildifier: disable=function-docstring
def checkout_merge_base(std: std.Std):
    out = std.io.stdout
    out.write("[1/6] Finding git merge-base with origin/main...\n")
    current_revision = exec(std.process.command("git").args(["rev-parse", "HEAD"]), std)
    out.write("  -> Current HEAD: %s\n" % current_revision)

    merge_base = exec(std.process.command("git").args(["merge-base", "HEAD", "origin/main"]), std)
    out.write("  -> Merge base: %s\n" % merge_base)

    out.write("  -> Checking out merge-base %s...\n" % merge_base)
    checkout = std.process.command("git").args(["checkout", merge_base, "--quiet"]).spawn()
    res = checkout.wait()
    if res.success:
        out.write("  -> Successfully checked out %s\n" % merge_base)
        return merge_base, current_revision, None
    else:
        return None, None, res.stderr

# buildifier: disable=function-docstring
def impl(ctx: TaskContext):
    out = ctx.std.io.stdout
    err = ctx.std.io.stderr

    out.write("[0/6] Building %s executable...\n" % ctx.args.bazel_diff_cli)
    build = ctx.bazel.build(
        ctx.args.bazel_diff_cli,
        build_events = True,
        flags = ["--build_runfile_links"],
    )
    (bazel_diff_command, runfiles) = (None, None)

    for event in build.events:
        out.write("\n--- [bazel-diff] Event %s ---\n" % event)

        if event.kind == "named_set_of_files":
            for file in event.payload.files:
                if len(file.path_prefix) == 0 or file.file.endswith(".jar"):
                    continue
                runfiles = file.file.removeprefix("file://") + ".runfiles"
                bazel_diff_command = file.file.removeprefix("file://")

    if not bazel_diff_command:
        err.write("Error: Could not locate built bazel-diff executable in runfiles.\n")
        return 1

    out.write("  -> Located bazel-diff binary at: %s\n" % bazel_diff_command)

    def bazel_diff(phase_name, args):
        out.write("\n--- [bazel-diff] Starting %s ---\n" % phase_name)
        out.write("Args: %s\n" % args)

        proc = ctx.std.process.command(bazel_diff_command) \
            .current_dir(runfiles) \
            .env("RUNFILES_DIR", runfiles) \
            .env("RUNFILES_MANIFEST_FILE", runfiles + "_manifest") \
            .env("BUILD_WORKSPACE_DIRECTORY", ctx.std.env.current_dir()) \
            .env("BUILD_WORKING_DIRECTORY", ctx.std.env.current_dir()) \
            .args(args) \
            .stdout("inherit") \
            .stderr("inherit") \
            .spawn()

        res = proc.wait()
        out.write("--- [bazel-diff] Finished %s (exit code %s) ---\n\n" % (phase_name, res.code))
        return res

    # 1. Merge Base Checkout
    (merge_base, current_revision, checkout_err) = checkout_merge_base(ctx.std)
    if checkout_err:
        err.write("Error checking out merge base: %s\n" % checkout_err)
        return 1

    starting_hashes_json = ctx.std.env.temp_dir() + "/starting_hashes.json"
    final_hashes_json = ctx.std.env.temp_dir() + "/final_hashes.json"
    impacted_targets_path = ctx.std.env.temp_dir() + "/impacted_targets.txt"

    # 2. Base Hashes Generation
    out.write("[2/6] Generating hashes for Base Revision (%s)...\n" % merge_base)
    gen_base = bazel_diff("generate-hashes (base)", [
        "generate-hashes",
        "-w", ctx.std.env.current_dir(),
        "--bazelCommandOptions", "--show_progress --show_loading_progress",
        starting_hashes_json,
    ])
    if not gen_base.success:
        err.write("Error generating base hashes (exit code: %s)\n" % gen_base.code)
        return 1

    # 3. Restore Revision
    out.write("[3/6] Restoring original revision (%s)...\n" % current_revision)
    restore = ctx.std.process.command("git").args(["checkout", current_revision, "--quiet"]).spawn()
    restore_res = restore.wait()
    if not restore_res.success:
        err.write("Error checking out original commit: %s\n" % restore_res.stderr)
        return 1
    out.write("  -> Restored HEAD to %s\n" % current_revision)

    # 4. Final Hashes Generation
    out.write("[4/6] Generating hashes for Current Revision (%s)...\n" % current_revision)
    gen_final = bazel_diff("generate-hashes (head)", [
        "generate-hashes",
        "-w", ctx.std.env.current_dir(),
        "--bazelCommandOptions", "--show_progress --show_loading_progress",
        final_hashes_json,
    ])
    if not gen_final.success:
        err.write("Error generating head hashes (exit code: %s)\n" % gen_final.code)
        return 1

    # 5. Calculate Diff
    out.write("[5/6] Diffing Hashes: %s -> %s...\n" % (starting_hashes_json, final_hashes_json))
    get_impacted = bazel_diff("get-impacted-targets", [
        "get-impacted-targets",
        "-sh", starting_hashes_json,
        "-fh", final_hashes_json,
        "-o", impacted_targets_path,
    ])
    if not get_impacted.success:
        err.write("Error computing impacted targets (exit code: %s)\n" % get_impacted.code)
        return 1

    # 6. Read Output
    out.write("[6/6] Reading impacted targets from %s...\n" % impacted_targets_path)
    impacted_targets = ctx.std.fs.read_to_string(impacted_targets_path)

    out.write("\n=== Impacted Targets for Revision %s ===\n" % current_revision)
    out.write(impacted_targets)
    out.write("\n==========================================\n")

    return 0

impacted = task(
    implementation = impl,
    summary = "Calculate and list Bazel targets impacted by changes",
    args = {
        "bazel_diff_cli": args.string(default = "//tools:bazel-diff"),
    },
)

